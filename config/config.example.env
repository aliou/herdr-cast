# Cast config — copy into your dotfiles and point at it:
#   export CAST_CONFIG="$HOME/.config/herdr-cast/config.env"
#
# Resolution order (later wins):
#   1. built-in default  (lib/config.sh)
#   2. environment variable (exported before the handler runs)
#   3. $HERDR_PLUGIN_CONFIG_DIR/config.env  (herdr-managed, per machine)
#   4. $CAST_CONFIG                   (this file)
# An env var exported EMPTY counts as unset; set it here to force empty.

# Which NEW agent statuses trigger a notification. Valid: working blocked idle
# done unknown. blocked = needs your input; done = turn ended (you haven't seen
# the pane yet).
TRIGGER_STATUSES="blocked done"

# Hide the native banner for the workspace you are currently looking at. Cast
# does not play sounds, so harness-owned sound playback is unaffected.
SUPPRESS_FOCUSED=1

# Bundle ids (space separated) of terminal apps that host herdr.
TERMINAL_APP_IDS="com.mitchellh.ghostty com.apple.Terminal com.googlecode.iterm2 net.kovidgoyal.kitty com.github.wez.wezterm org.alacritty"

# Drop a repeated (pane,status) seen within this many seconds.
DEBOUNCE_SECONDS=2

# Click the notification to jump to the agent that changed.
ACTIVATE_ON_CLICK=1
CLICK_COMMAND="agent focus {pane}"
# `herdr agent focus` switches the pane server-side but does NOT raise the
# terminal window. When you click from another app, prepend `open -a <name>` so
# the terminal comes forward first. Auto-detected from TERM_PROGRAM (Ghostty /
# WezTerm); falls back to ACTIVATE_APP_FALLBACK (default "Ghostty") for anything
# else. Set explicitly to force a value, or empty to disable window activation.
# ACTIVATE_APP="Ghostty"
# ACTIVATE_APP_FALLBACK="Ghostty"

# Notifier binary. Empty = bundled assets/HerdrNotify.app (herdr left icon).
# NOTIFIER=""

# Right-side image mode. The LEFT icon is always the notifier app's.
ICON_MODE=contentImage

# Notification group key (template). Default "{pane}" keeps one live
# notification per pane; "{pane}-{new_status}" keeps blocked and done separate.
GROUP="{pane}"

# Per-status templates. Placeholders:
#   {agent} {workspace} {worktree} {tab} {tab_label} {pane} {session}
#   {old_status} {new_status} {cwd}
TITLE_BLOCKED="⏳ {agent} needs input"
BODY_BLOCKED="{workspace} · {worktree}"
ICON_BLOCKED="assets/icons/blocked.png"

TITLE_DONE="✅ {agent} done"
BODY_DONE="{workspace} · {worktree}"
ICON_DONE="assets/icons/done.png"

TITLE_DEFAULT="{agent}: {new_status}"
BODY_DEFAULT="{workspace} · {worktree}"
ICON_DEFAULT="assets/icons/working.png"

# Uncomment to dump raw event/context JSON + decision trace to the state dir.
# DEBUG=1
